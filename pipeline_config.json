{
  "_comment": "Unified config file - all scripts read from this single file",
  "scene": {
    "seed": 42,
    "mode": "random",
    "force_complete_random": false,
    "mesh_folder": "Meshy",
    "output_manifest": "outputs/room_manifest.json",
    "manifest_path": "outputs/room_manifest.json",
    "clear_scene_first": true,
    "origin": [
      0.0,
      0.0,
      0.0
    ],
    "room": {
      "mode": "random",
      "manual": {
        "name": "meshy_room_manual",
        "width": 10.0,
        "depth": 10.0,
        "height": 4.0,
        "wall_thickness": 0.12,
        "open_top": true
      },
      "random": {
        "name_prefix": "meshy_room",
        "width_range": [
          7.0,
          14.0
        ],
        "depth_range": [
          7.0,
          14.0
        ],
        "height_range": [
          3.0,
          5.0
        ],
        "wall_thickness_range": [
          0.08,
          0.2
        ],
        "open_top": true
      }
    },
    "placement": {
      "mode": "random",
      "random": {
        "max_attempts_per_asset": 250,
        "min_gap": 0.2,
        "random_yaw_deg": [
          0.0,
          360.0
        ],
        "random_scale_uniform": [
          0.6,
          1.8
        ],
        "z_on_floor": true,
        "margin_from_walls": 0.35
      }
    },
    "assets": []
  },
  "lighting": {
    "main_light_energy": 800,
    "main_light_height": 2.8,
    "aux_lights": 2,
    "aux_light_energy": 300,
    "adaptive": true,
    "reference_area": 100,
    "max_energy_scale": 2.4,
    "max_aux_lights": 4,
    "ambient_strength": 0.08
  },
  "cameras": {
    "lens_mm": 24,
    "sensor_width": 36,
    "clip_start": 0.1,
    "clip_end": 100.0,
    "drones": [
      {
        "id": "camera_01",
        "role": "low_sweep_left",
        "description": "Low-altitude longitudinal sweep - left side of room, south to north along Y axis",
        "init_pos": [
          -2.0,
          -5.0,
          1.4
        ],
        "init_rot_deg": [
          70.0,
          0.0,
          15.0
        ]
      },
      {
        "id": "camera_02",
        "role": "low_sweep_right",
        "description": "Low-altitude longitudinal sweep - right side of room, north to south (reverse direction for coverage diversity)",
        "init_pos": [
          2.0,
          5.0,
          1.4
        ],
        "init_rot_deg": [
          70.0,
          0.0,
          195.0
        ]
      },
      {
        "id": "camera_03",
        "role": "high_orbit",
        "description": "High-altitude elliptical orbit - global overview from room center",
        "init_pos": [
          0.0,
          0.0,
          2.8
        ],
        "init_rot_deg": [
          35.0,
          0.0,
          0.0
        ]
      }
    ]
  },
  "trajectory": {
    "boundary_margin": 0.5,
    "height_range": [
      0.9,
      3.2
    ],
    "camera_01": {
      "pattern": "diagonal",
      "direction": "SW_to_NE",
      "_comment_direction": "left-bottom corner to right-top corner",
      "total_frames": 80,
      "height": 1.4,
      "height_end": 1.4,
      "look_pitch_deg": 65,
      "look_mode": "sweep",
      "n_sweeps": 3
    },
    "camera_02": {
      "pattern": "diagonal",
      "direction": "SE_to_NW",
      "_comment_direction": "right-bottom corner to left-top corner (crosses camera_01)",
      "total_frames": 80,
      "height": 1.6,
      "height_end": 1.6,
      "look_pitch_deg": 65,
      "look_mode": "sweep",
      "n_sweeps": 3
    },
    "camera_03": {
      "pattern": "orbit",
      "total_frames": 60,
      "height": 2.9,
      "radius_ratio": 0.38,
      "look_pitch_deg": 42,
      "_comment": "Elliptical orbit centered on room origin, radius_ratio relative to half room width/depth",
      "dual_radius": true
    }
  },
  "render": {
    "resolution_x": 1280,
    "resolution_y": 720,
    "samples": 16,
    "engine": "BLENDER_EEVEE",
    "file_format": "PNG",
    "color_depth": "8"
  },
  "video": {
    "fps": 24,
    "codec": "libx264",
    "crf": 18
  },
  "coverage": {
    "grid_resolution": 0.5,
    "min_coverage_threshold": 0.75,
    "keyframe_interval": 10,
    "min_angles": 3,
    "score_alpha": 0.5,
    "object_weight_min": 20,
    "object_weight_max": 200
  },
  "vlm": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "max_tokens": 2048,
    "max_keyframes_per_camera": 5,
    "supplementary_defaults": {
      "region_height": 1.5,
      "region_radius": 1.2,
      "object_height": 1.2,
      "object_radius": 0.7
    },
    "hint_keyframes_per_camera": 1
  },
  "budget": {
    "total_frames": 200,
    "cameras_allowed": [
      "camera_01",
      "camera_02",
      "camera_03"
    ],
    "frames_per_visit": 20,
    "max_visits": 12
  },
  "exploration": {
    "max_rounds": 3,
    "frames_per_supplementary": 20,
    "stop_if_coverage_above": 0.95,
    "sparsity_threshold": 0.15,
    "min_dist_sparse": 2.5,
    "min_dist_dense": 1.5,
    "min_dist_schedule": [1.2, 1.0, 0.8],
    "max_orbits_per_object": 2,
    "visits_schedule": [3, 4, 5]
  },
  "output": {
    "base_dir": "outputs",
    "run_prefix": "run"
  }
}
