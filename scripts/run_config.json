{
  "meta": {
    "project_name": "indoor_capture",
    "version": "1.0.0"
  },

  "scene": {
    "seed": 42,
    "blend_file": "scenes/room.blend",
    "room_size": [8.0, 6.0, 3.0],
    "assets_dir": "assets/Meshy",
    "object_count": 8,
    "object_scale_range": [0.3, 1.2]
  },

  "lighting": {
    "main_light_energy": 800,
    "main_light_height": 2.8,
    "aux_lights": 2,
    "aux_light_energy": 200
  },

  "cameras": {
    "count": 3,
    "lens_mm": 24,
    "sensor_width": 36,
    "clip_start": 0.1,
    "clip_end": 100.0,
    "roles": [
      {
        "id": "camera_01",
        "role": "low_left",
        "init_pos": [-2.5, -2.0, 1.2],
        "init_rot_deg": [75, 0, 45]
      },
      {
        "id": "camera_02",
        "role": "low_right",
        "init_pos": [2.5, 2.0, 1.2],
        "init_rot_deg": [75, 0, 225]
      },
      {
        "id": "camera_03",
        "role": "high_overview",
        "init_pos": [0.0, 0.0, 2.5],
        "init_rot_deg": [30, 0, 0]
      }
    ]
  },

  "trajectory": {
    "type": "preset",
    "frames_per_camera": 60,
    "patterns": {
      "camera_01": "diagonal",
      "camera_02": "perimeter",
      "camera_03": "orbit"
    },
    "height_range": [0.8, 2.5],
    "boundary_margin": 0.4
  },

  "render": {
    "resolution_x": 1280,
    "resolution_y": 720,
    "samples": 64,
    "engine": "CYCLES",
    "file_format": "PNG",
    "color_depth": "8"
  },

  "video": {
    "fps": 24,
    "codec": "libx264",
    "crf": 18
  },

  "coverage": {
    "grid_resolution": 0.5,
    "min_coverage_threshold": 0.75,
    "keyframe_interval": 10
  },

  "vlm": {
    "provider": "anthropic",
    "model": "claude-opus-4-5",
    "max_keyframes_per_camera": 5,
    "max_tokens": 2048,
    "temperature": 0.3
  },

  "exploration": {
    "max_rounds": 3,
    "frames_per_supplementary": 20,
    "stop_if_coverage_above": 0.90
  },

  "output": {
    "base_dir": "outputs",
    "run_prefix": "run"
  }
}
